<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jacky Masagnay | IT Portfolio</title>

    <meta name="description"
          content="Jacky Masagnay - IT Portfolio, Technology Projects, IoT, OCR, Microcontrollers and System Development.">

    <style>
        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #070b14;
            color: #ffffff;
            overflow-x: hidden;
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font-family: inherit;
        }

        /* =====================================================
           BACKGROUND
        ===================================================== */

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -3;
            background:
                radial-gradient(circle at 15% 20%, rgba(0, 212, 255, 0.10), transparent 30%),
                radial-gradient(circle at 85% 30%, rgba(117, 76, 255, 0.12), transparent 30%),
                radial-gradient(circle at 50% 90%, rgba(0, 255, 170, 0.06), transparent 30%);
        }

        .grid-background {
            position: fixed;
            inset: 0;
            z-index: -2;
            opacity: 0.12;
            background-image:
                linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 45px 45px;
            mask-image: linear-gradient(to bottom, black, transparent);
        }

        .glow {
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: .15;
            z-index: -1;
            pointer-events: none;
        }

        .glow.one {
            background: #00d9ff;
            top: 10%;
            left: -150px;
        }

        .glow.two {
            background: #8c52ff;
            right: -150px;
            top: 40%;
        }

        /* =====================================================
           NAVIGATION
        ===================================================== */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 20px 6%;
            transition: .3s;
        }

        header.scrolled {
            padding: 12px 6%;
            background: rgba(7, 11, 20, .85);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        nav {
            max-width: 1200px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .logo-box {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: linear-gradient(135deg, #00d9ff, #7657ff);
            color: white;
            box-shadow: 0 0 30px rgba(0,217,255,.25);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: #aeb7c8;
            font-size: 14px;
            transition: .3s;
        }

        .nav-links a:hover {
            color: white;
        }

        .nav-contact {
            padding: 10px 18px;
            border: 1px solid rgba(0,217,255,.5);
            border-radius: 100px;
            color: white !important;
        }

        .menu-btn {
            display: none;
            border: none;
            background: transparent;
            color: white;
            font-size: 27px;
            cursor: pointer;
        }

        /* =====================================================
           GENERAL
        ===================================================== */

        section {
            padding: 110px 6%;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        .section-label {
            display: inline-block;
            margin-bottom: 14px;
            color: #00d9ff;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .section-title {
            font-size: clamp(32px, 5vw, 52px);
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .section-description {
            max-width: 650px;
            color: #98a3b6;
            font-size: 16px;
        }

        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 140px;
        }

        .hero-grid {
            max-width: 1200px;
            width: 100%;
            margin: auto;
            display: grid;
            grid-template-columns: 1.1fr .9fr;
            gap: 70px;
            align-items: center;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 13px;
            border-radius: 100px;
            border: 1px solid rgba(0,255,170,.2);
            background: rgba(0,255,170,.05);
            color: #75f7c4;
            font-size: 13px;
            margin-bottom: 24px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: #00e99b;
            border-radius: 50%;
            box-shadow: 0 0 15px #00e99b;
        }

        .hero h1 {
            font-size: clamp(48px, 7vw, 88px);
            line-height: .95;
            letter-spacing: -4px;
            margin-bottom: 25px;
        }

        .hero h1 span {
            display: block;
            background: linear-gradient(90deg, #00d9ff, #8d6bff, #00ffaa);
            background-size: 200%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: gradientMove 5s linear infinite;
        }

        @keyframes gradientMove {
            0% { background-position: 0%; }
            100% { background-position: 200%; }
        }

        .hero-description {
            max-width: 600px;
            color: #9ca8bb;
            font-size: 17px;
            margin-bottom: 32px;
        }

        .hero-buttons {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 14px 22px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 14px;
            border: 1px solid rgba(255,255,255,.12);
            transition: .3s;
            cursor: pointer;
        }

        .btn-primary {
            color: #061018;
            background: linear-gradient(135deg, #00d9ff, #00ffa8);
            box-shadow: 0 10px 30px rgba(0,217,255,.16);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0,217,255,.25);
        }

        .btn-secondary {
            color: white;
            background: rgba(255,255,255,.04);
        }

        .btn-secondary:hover {
            background: rgba(255,255,255,.09);
            transform: translateY(-3px);
        }

        /* =====================================================
           HERO VISUAL
        ===================================================== */

        .hero-visual {
            position: relative;
            height: 500px;
            display: grid;
            place-items: center;
        }

        .orbit {
            position: absolute;
            width: 380px;
            height: 380px;
            border: 1px solid rgba(0,217,255,.16);
            border-radius: 50%;
            animation: rotate 18s linear infinite;
        }

        .orbit::before,
        .orbit::after {
            content: "";
            position: absolute;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #00d9ff;
            box-shadow: 0 0 20px #00d9ff;
        }

        .orbit::before {
            top: 35px;
            left: 60px;
        }

        .orbit::after {
            right: 25px;
            bottom: 70px;
            background: #8d6bff;
            box-shadow: 0 0 20px #8d6bff;
        }

        .orbit.second {
            width: 280px;
            height: 280px;
            border-color: rgba(141,107,255,.15);
            animation-direction: reverse;
            animation-duration: 12s;
        }

        .profile-card {
            width: 250px;
            height: 300px;
            border-radius: 30px;
            background: linear-gradient(
                145deg,
                rgba(255,255,255,.10),
                rgba(255,255,255,.025)
            );
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 3;
            box-shadow:
                0 30px 80px rgba(0,0,0,.45),
                inset 0 1px rgba(255,255,255,.1);
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 42px;
            font-weight: 900;
            background: linear-gradient(135deg, #00d9ff, #7657ff);
            box-shadow: 0 0 50px rgba(0,217,255,.22);
            margin-bottom: 20px;
        }

        .profile-card h3 {
            font-size: 21px;
        }

        .profile-card p {
            color: #929daf;
            font-size: 13px;
            margin-top: 5px;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* =====================================================
           STATS
        ===================================================== */

        .stats {
            padding-top: 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border-top: 1px solid rgba(255,255,255,.08);
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .stat {
            padding: 28px 20px;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,.08);
        }

        .stat:last-child {
            border-right: none;
        }

        .stat strong {
            display: block;
            font-size: 30px;
            margin-bottom: 4px;
        }

        .stat span {
            color: #8f99ab;
            font-size: 13px;
        }

        /* =====================================================
           ABOUT
        ===================================================== */

        .about-grid {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            gap: 70px;
            align-items: center;
        }

        .about-card {
            padding: 35px;
            border: 1px solid rgba(255,255,255,.09);
            background: rgba(255,255,255,.035);
            border-radius: 25px;
        }

        .about-card p {
            color: #9ba6b9;
            margin-bottom: 20px;
        }

        .about-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 25px;
        }

        .info-item {
            padding: 17px;
            border-radius: 15px;
            background: rgba(255,255,255,.035);
            border: 1px solid rgba(255,255,255,.06);
        }

        .info-item small {
            color: #707c90;
            display: block;
            margin-bottom: 5px;
        }

        .info-item strong {
            font-size: 14px;
        }

        /* =====================================================
           PROJECTS
        ===================================================== */

        .projects-header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            margin-bottom: 45px;
            gap: 30px;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .project-card {
            position: relative;
            overflow: hidden;
            padding: 30px;
            min-height: 310px;
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,.09);
            background: linear-gradient(
                145deg,
                rgba(255,255,255,.07),
                rgba(255,255,255,.025)
            );
            transition: .4s;
        }

        .project-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0,217,255,.3);
            box-shadow: 0 25px 70px rgba(0,0,0,.3);
        }

        .project-number {
            position: absolute;
            top: 20px;
            right: 25px;
            font-size: 70px;
            font-weight: 900;
            color: rgba(255,255,255,.035);
        }

        .project-icon {
            width: 58px;
            height: 58px;
            border-radius: 17px;
            display: grid;
            place-items: center;
            font-size: 27px;
            background: rgba(0,217,255,.08);
            border: 1px solid rgba(0,217,255,.16);
            margin-bottom: 25px;
        }

        .project-card h3 {
            font-size: 22px;
            margin-bottom: 12px;
            position: relative;
        }

        .project-card p {
            color: #919daf;
            font-size: 14px;
            max-width: 500px;
            position: relative;
        }

        .tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .tag {
            padding: 6px 10px;
            border-radius: 100px;
            font-size: 11px;
            color: #a9dff0;
            background: rgba(0,217,255,.07);
            border: 1px solid rgba(0,217,255,.12);
        }

        /* =====================================================
           SKILLS
        ===================================================== */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-top: 45px;
        }

        .skill {
            padding: 24px;
            border-radius: 18px;
            background: rgba(255,255,255,.035);
            border: 1px solid rgba(255,255,255,.07);
            transition: .3s;
        }

        .skill:hover {
            transform: translateY(-5px);
            border-color: rgba(0,217,255,.25);
        }

        .skill-icon {
            font-size: 28px;
            margin-bottom: 15px;
        }

        .skill h3 {
            font-size: 15px;
            margin-bottom: 5px;
        }

        .skill p {
            color: #7f899b;
            font-size: 12px;
        }

        /* =====================================================
           CONTACT
        ===================================================== */

        .contact-box {
            position: relative;
            overflow: hidden;
            padding: 65px;
            text-align: center;
            border-radius: 30px;
            border: 1px solid rgba(0,217,255,.16);
            background:
                radial-gradient(circle at 50% 0%, rgba(0,217,255,.10), transparent 50%),
                rgba(255,255,255,.035);
        }

        .contact-box h2 {
            font-size: clamp(32px, 5vw, 55px);
            margin-bottom: 15px;
        }

        .contact-box p {
            color: #909bad;
            max-width: 600px;
            margin: auto auto 30px;
        }

        .contact-links {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* =====================================================
           FOOTER
        ===================================================== */

        footer {
            padding: 35px 6%;
            border-top: 1px solid rgba(255,255,255,.07);
        }

        .footer-inner {
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        footer p {
            color: #697386;
            font-size: 13px;
        }

        .back-top {
            color: #00d9ff;
            font-size: 13px;
        }

        /* =====================================================
           REVEAL ANIMATION
        ===================================================== */

        .reveal {
            opacity: 0;
            transform: translateY(35px);
            transition: opacity .8s ease, transform .8s ease;
        }

        .reveal.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 900px) {

            .hero-grid,
            .about-grid {
                grid-template-columns: 1fr;
            }

            .hero {
                padding-top: 130px;
            }

            .hero-visual {
                height: 420px;
            }

            .projects-grid {
                grid-template-columns: 1fr;
            }

            .skills-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat:nth-child(2) {
                border-right: none;
            }

            .stat:nth-child(-n+2) {
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .projects-header {
                display: block;
            }
        }

        @media (max-width: 700px) {

            header {
                padding: 16px 5%;
            }

            .menu-btn {
                display: block;
            }

            .nav-links {
                position: absolute;
                top: 75px;
                left: 5%;
                right: 5%;
                display: none;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                padding: 12px;
                border-radius: 18px;
                background: rgba(8,12,22,.96);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,.1);
            }

            .nav-links.active {
                display: flex;
            }

            .nav-links li a {
                display: block;
                padding: 13px;
            }

            section {
                padding: 80px 5%;
            }

            .hero h1 {
                font-size: 52px;
                letter-spacing: -3px;
            }

            .orbit {
                width: 300px;
                height: 300px;
            }

            .orbit.second {
                width: 220px;
                height: 220px;
            }

            .profile-card {
                width: 210px;
                height: 260px;
            }

            .profile-avatar {
                width: 100px;
                height: 100px;
            }

            .skills-grid {
                grid-template-columns: 1fr 1fr;
            }

            .contact-box {
                padding: 40px 22px;
            }

            .footer-inner {
                flex-direction: column;
                text-align: center;
            }
        }

        @media (max-width: 450px) {

            .hero h1 {
                font-size: 43px;
            }

            .skills-grid {
                grid-template-columns: 1fr;
            }

            .about-info {
                grid-template-columns: 1fr;
            }

            .hero-buttons .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="grid-background"></div>
    <div class="glow one"></div>
    <div class="glow two"></div>

    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <header id="header">

        <nav>

            <a href="#home" class="logo">
                <span class="logo-box">JM</span>
                <span>JACKY MASAGNAY</span>
            </a>

            <button class="menu-btn" id="menuBtn">
                ☰
            </button>

            <ul class="nav-links" id="navLinks">

                <li>
                    <a href="#home">Home</a>
                </li>

                <li>
                    <a href="#about">About</a>
                </li>

                <li>
                    <a href="#projects">Projects</a>
                </li>

                <li>
                    <a href="#skills">Skills</a>
                </li>

                <li>
                    <a href="#contact" class="nav-contact">
                        Contact
                    </a>
                </li>

            </ul>

        </nav>

    </header>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <main>

        <section class="hero" id="home">

            <div class="hero-grid">

                <div class="hero-content reveal">

                    <div class="status">
                        <span class="status-dot"></span>
                        Available for opportunities
                    </div>

                    <h1>
                        Jacky
                        <span>Masagnay.</span>
                    </h1>

                    <p class="hero-description">
                        IT student and technology enthusiast focused on
                        developing practical systems using software,
                        electronics, IoT, automation, OCR and microcontrollers.
                    </p>

                    <div class="hero-buttons">

                        <a href="#projects" class="btn btn-primary">
                            View My Projects →
                        </a>

                        <a href="#contact" class="btn btn-secondary">
                            Contact Me
                        </a>

                    </div>

                </div>


                <div class="hero-visual reveal">

                    <div class="orbit"></div>
                    <div class="orbit second"></div>

                    <div class="profile-card">

                        <div class="profile-avatar">
                            JM
                        </div>

                        <h3>Jacky Masagnay</h3>

                        <p>
                            IT • IoT • Systems Development
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             STATS
        ================================================== -->

        <section class="stats">

            <div class="container">

                <div class="stats-grid">

                    <div class="stat">
                        <strong>05</strong>
                        <span>Featured Projects</span>
                    </div>

                    <div class="stat">
                        <strong>IoT</strong>
                        <span>Hardware & Systems</span>
                    </div>

                    <div class="stat">
                        <strong>OCR</strong>
                        <span>Receipt Processing</span>
                    </div>

                    <div class="stat">
                        <strong>AI</strong>
                        <span>Technology Exploration</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             ABOUT
        ================================================== -->

        <section id="about">

            <div class="container about-grid">

                <div class="reveal">

                    <span class="section-label">
                        About Me
                    </span>

                    <h2 class="section-title">
                        Building technology with purpose.
                    </h2>

                </div>


                <div class="about-card reveal">

                    <p>
                        Hello! I'm <strong>Jacky Masagnay</strong>, an IT
                        student interested in software development,
                        electronics, automation, IoT and innovative
                        technology solutions.
                    </p>

                    <p>
                        My projects combine programming and hardware to
                        solve real-world problems. I enjoy designing
                        applications, experimenting with microcontrollers,
                        building automated systems and creating useful
                        digital experiences.
                    </p>

                    <div class="about-info">

                        <div class="info-item">
                            <small>Name</small>
                            <strong>Jacky Masagnay</strong>
                        </div>

                        <div class="info-item">
                            <small>Field</small>
                            <strong>Information Technology</strong>
                        </div>

                        <div class="info-item">
                            <small>Focus</small>
                            <strong>Systems & IoT</strong>
                        </div>

                        <div class="info-item">
                            <small>Location</small>
                            <strong>Philippines</strong>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             PROJECTS
        ================================================== -->

        <section id="projects">

            <div class="container">

                <div class="projects-header reveal">

                    <div>

                        <span class="section-label">
                            Selected Work
                        </span>

                        <h2 class="section-title">
                            Projects
                        </h2>

                    </div>

                    <p class="section-description">
                        A collection of technology projects combining
                        software, electronics, automation and intelligent
                        systems.
                    </p>

                </div>


                <div class="projects-grid">

                    <!-- PROJECT 01 -->

                    <article class="project-card reveal">

                        <span class="project-number">01</span>

                        <div class="project-icon">
                            ❤️
                        </div>

                        <h3>
                            Cardiovascular Monitoring System
                        </h3>

                        <p>
                            A smart monitoring prototype designed to
                            collect cardiovascular information using
                            electronic sensors and a microcontroller.
                        </p>

                        <div class="tags">
                            <span class="tag">ESP32</span>
                            <span class="tag">ECG</span>
                            <span class="tag">SpO2</span>
                            <span class="tag">IoT</span>
                        </div>

                    </article>


                    <!-- PROJECT 02 -->

                    <article class="project-card reveal">

                        <span class="project-number">02</span>

                        <div class="project-icon">
                            🧾
                        </div>

                        <h3>
                            ReceiScan OCR Application
